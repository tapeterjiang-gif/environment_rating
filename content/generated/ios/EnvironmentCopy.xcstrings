    "env_hcho_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新家具或装修材料可能持续释放甲醛。读数偏高时，先找来源，并在室外空气合适时通风；如果持续偏高，可以安排专业检测。只闻不到气味，不能说明甲醛已经降低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新家具或裝修材料可能持續釋放甲醛。讀數偏高時，先找來源，並在室外空氣合適時通風；如果持續偏高，可以安排專業檢測。只聞不到氣味，不能說明甲醛已經降低。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New furniture or renovation materials may keep releasing formaldehyde. If elevated, look for sources and ventilate when outdoor air is suitable. Persistent readings may warrant professional testing. No noticeable smell does not prove levels have fallen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい家具や内装材からはホルムアルデヒドが放散し続けることがあります。高い場合は発生源を探し、外気が適切なら換気しましょう。高い値が続く場合は専門測定を検討してください。においがしないことは、濃度が下がった証拠にはなりません。"
          }
        }
      }
    },
    "env_hcho_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "甲醛是一种可能由板材、家具等材料释放的气体。应结合所选标准要求的平均时间观察浓度；读数较高时，优先排查释放源，并在室外条件允许时通风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "甲醛是可能由板材、家具等材料釋放的氣體。應依所選標準要求的平均時間觀察濃度；讀數較高時，優先排查釋放源，並在室外條件允許時通風。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formaldehyde is a gas that may be released by panels, furniture, and other materials. Read concentrations over the averaging period required by the selected reference. If elevated, check emission sources and ventilate when outdoor conditions allow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホルムアルデヒドは建材や家具などから放散されることがある気体です。選択した基準の平均時間に沿って濃度を確認し、高い場合は発生源を調べ、屋外の状況が許せば換気します。"
          }
        }
      }
    },
    "env_hcho_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "甲醛 HCHO"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "甲醛 HCHO"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formaldehyde (HCHO)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホルムアルデヒド HCHO"
          }
        }
      }
    },
