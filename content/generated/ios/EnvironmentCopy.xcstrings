    "env_noise_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果声音影响了专注或休息，可以先关小音量、移动发声设备，或去更安静的位置。睡觉时更容易被声音打扰，可以切换到睡眠场景查看提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果聲音影響了專注或休息，可以先關小音量、移動發聲設備，或去更安靜的位置。睡覺時更容易被聲音打擾，可以切換到睡眠場景查看提示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If sound affects focus or rest, lower the volume, move noisy equipment, or find a quieter spot. Use the sleep scene for guidance when resting, as sound can be more disruptive then."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中や休息の妨げになる音があれば、音量を下げたり、機器を移動したり、静かな場所を選びましょう。就寝時は音が気になりやすいため、睡眠の場面設定を使えます。"
          }
        }
      }
    },
    "env_noise_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "噪声读数反映测量位置的声音强弱，使用 A 计权更接近人耳对不同频率的敏感程度。是否影响休息还取决于持续时间与场景；睡眠提示采用更严格的边界。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "噪聲讀數反映測量位置的聲音強弱，A 加權較接近人耳對不同頻率的敏感程度。是否影響休息還取決於持續時間與場景；睡眠提示採用更嚴格的邊界。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noise readings describe sound level at the measurement location. A weighting reflects the ear’s differing sensitivity to frequencies. Effects on rest depend on duration and context; the sleep scene uses stricter boundaries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "騒音値は測定位置での音の強さを表します。A特性は周波数による耳の感度の違いを反映します。休息への影響は時間や場面にも左右され、睡眠の案内ではより厳しい境界を使います。"
          }
        }
      }
    },
    "env_noise_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "噪声"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "噪聲"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "騒音"
          }
        }
      }
    },
    "env_noise_rating_loud_detail": {
      "localizations": {
