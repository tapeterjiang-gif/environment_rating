    "env_standard_uba_co2_2008_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "德国联邦环境署的 CO₂ 指导值，主要帮助判断室内换气是否值得关注。它以 1000 ppm 和 2000 ppm 为分界，将情况分为三个区间。本项目据此提供“正常、建议通风、应加强通风”的提示，让你知道什么时候可以开窗或增加新风；这不是用来判断一氧化碳等其他污染物的标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "德國聯邦環境署的 CO₂ 指導值，主要協助判斷室內換氣是否需要關注。它以 1000 ppm 與 2000 ppm 為分界，劃分三個區間。本專案據此提供「正常、建議通風、應加強通風」提示，協助判斷何時可以開窗或增加新風；這不是評價一氧化碳等其他污染物的標準。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The German Environment Agency’s CO₂ guidance helps identify indoor ventilation conditions that deserve attention. It uses 1000 and 2000 ppm as the boundaries between three ranges. The project turns these into Normal, Ventilate, and Increase Ventilation messages, helping you consider opening windows or adding fresh air. The reference does not assess other pollutants such as carbon monoxide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドイツ連邦環境庁のCO₂指針は、室内換気に注意が必要かを考えるための目安です。1000 ppmと2000 ppmで3つの範囲を分けます。本製品では正常・換気を推奨・換気を強化という案内にして、窓開けや外気導入を考える助けにします。一酸化炭素など別の物質を評価する基準ではありません。"
          }
        }
      }
    },
    "env_standard_uba_co2_2008_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "德国 UBA 2008 CO₂ 指导值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "德國 UBA 2008 CO₂ 指導值"
          }
        },
        "en": {
