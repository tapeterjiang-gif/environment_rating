    "env_pmv_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感觉冷或热时，可以先从衣着、空调和风扇做小幅调整，等一会儿再看体感是否改善。每个人的舒适点不同，不必为了追求“中性”反复调节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感覺冷或熱時，可以先從衣著、空調與風扇做小幅調整，等一會兒再看體感是否改善。每個人的舒適點不同，不必為了追求「中性」反覆調節。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you feel cold or warm, try a small change to clothing, air conditioning, or a fan, then give it time. Comfort varies, so there is no need to keep adjusting just to reach Neutral."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寒さや暑さを感じたら、服装、空調、扇風機を少し調整して様子を見ましょう。快適さは人それぞれなので、「中立」を目指して何度も調整する必要はありません。"
          }
        }
      }
    },
    "env_pmv_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PMV 根据空气温度、辐射温度、湿度、风速、活动量和衣着，估计一群人的平均冷热感。负值偏冷，正值偏热，接近 0 表示中性；个人的实际感受仍可能不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PMV 根據空氣溫度、輻射溫度、濕度、風速、活動量與衣著，估計一群人的平均冷熱感。負值偏冷，正值偏熱，接近 0 表示中性；個人的實際感受仍可能不同。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PMV estimates a group’s average thermal sensation from air and radiant temperature, humidity, air speed, activity, and clothing. Negative values indicate cooler sensations, positive values warmer ones, and values near zero neutral sensations. Individual feelings can still differ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PMVは気温、放射温度、湿度、風速、活動量、服装から集団の平均的な温冷感を推定します。負の値は寒い側、正の値は暑い側、0付近は中立を示します。個人の実際の感覚は異なる場合があります。"
          }
        }
      }
    },
    "env_pmv_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PMV 冷热感"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PMV 冷熱感"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PMV thermal sensation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PMVの温冷感"
          }
        }
      }
    },
