    "env_standard_eea_aqi_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欧洲空气质量指数由欧洲环境署提供，用六个等级把不同污染物的浓度转成容易阅读的空气质量提示。它适合帮助公众理解短期空气状况。本项目默认用它评价 PM2.5 和 PM10，也提供臭氧与二氧化硫的对应分档；这里展示的是各项污染物的结果，不是一个完整的欧洲官方综合指数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歐洲空氣品質指數由歐洲環境署提供，以六個等級將不同污染物濃度轉為易讀提示，協助公眾理解短期空氣狀況。本專案預設用它評價 PM2.5 與 PM10，也提供臭氧及二氧化硫的對應分檔；這裡展示各項污染物的結果，並非完整的歐洲官方綜合指數。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The European Air Quality Index, provided by the European Environment Agency, translates pollutant concentrations into six easy-to-read levels for understanding short-term air conditions. It is the project’s default for PM2.5 and PM10, with corresponding ozone and sulfur dioxide bands also available. The displayed results describe individual pollutants, rather than a complete official European aggregate index."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欧州大気質指数は欧州環境庁が提供し、汚染物質の濃度を6段階の読みやすい案内に変え、短期的な大気の状況を伝えます。本製品ではPM2.5とPM10の既定の基準として使い、オゾンと二酸化硫黄の区分も用意しています。表示するのは個別物質の結果であり、欧州公式の総合指数そのものではありません。"
          }
        }
      }
    },
    "env_standard_eea_aqi_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "EEA European Air Quality Index"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "EEA European Air Quality Index"
          }
        },
