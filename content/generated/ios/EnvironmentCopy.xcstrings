    "env_pm25_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做饭、点香或吸烟后读数升高，可以先减少烟雾来源、打开油烟机，或开启颗粒物净化设备。准备开窗前，先看看室外空气；外面污染较重时，开窗可能把颗粒物带进来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做飯、點香或吸菸後讀數升高，可以先減少煙霧來源、打開抽油煙機，或開啟顆粒物淨化設備。準備開窗前，先看看室外空氣；外面污染較重時，開窗可能把顆粒物帶進來。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If readings rise after cooking, incense, or smoking, reduce the smoke source, use an extractor, or run particle filtration. Check outdoor air before opening windows; polluted air can bring more particles inside."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調理、お香、喫煙の後に値が上がったら、煙の発生源を減らし、換気扇や粒子用の空気清浄機を使いましょう。窓を開ける前に屋外の空気を確認してください。汚染された外気から粒子が入ることもあります。"
          }
        }
      }
    },
    "env_pm25_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PM2.5 是空气中空气动力学直径通常不超过 2.5 微米的细颗粒物，可来自燃烧、烹饪或室外污染。细颗粒物能进入肺部，需结合浓度、持续时间与室外情况，考虑过滤或减少污染来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PM2.5 是空氣中空氣動力學直徑通常不超過 2.5 微米的細顆粒物，可來自燃燒、烹飪或室外污染。細顆粒物能進入肺部，需結合濃度、持續時間與室外情況，考慮過濾或減少污染來源。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PM2.5 is fine airborne particulate matter generally no more than 2.5 micrometers in aerodynamic diameter. Sources include combustion, cooking, and outdoor pollution. These particles can enter the lungs; consider concentration, duration, and outdoor conditions when reducing sources or filtering air."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PM2.5は空気力学径が通常2.5マイクロメートル以下の微小粒子です。燃焼、調理、屋外汚染などが発生源となります。肺に入り込むため、濃度、継続時間、屋外の状況を踏まえて発生源対策やろ過を検討します。"
          }
        }
      }
    },
    "env_pm25_name": {
      "localizations": {
