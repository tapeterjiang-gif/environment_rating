    "env_standard_ashrae_55_scale_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ASHRAE Standard 55 中的七点热感觉标尺，用“冷、凉、稍凉、中性、稍暖、暖、热”表达从 −3 到 +3 的冷热感，比单看一个温度数字更直观。本项目用这七个名称展示 PMV，并将连续数值分成方便阅读的区间；这些显示区间是产品规则，不能单凭一个标签判断房间是否符合整项标准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ASHRAE Standard 55 的七點熱感覺標尺，以「冷、涼、稍涼、中性、稍暖、暖、熱」表達 −3 到 +3 的冷熱感，比單看溫度數字更直覺。本專案以這七個名稱展示 PMV，並將連續數值分成易讀區間；這些顯示區間屬於產品規則，不能單憑標籤判斷房間是否符合整項標準。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The seven-point thermal sensation scale used in ASHRAE Standard 55 describes sensations from Cold through Neutral to Hot, on a scale from −3 to +3. This gives a more familiar meaning to a PMV number. The project uses these names with its own continuous display bands; a label alone does not establish that a room meets the full standard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ASHRAE Standard 55の7段階の温冷感尺度は、−3から＋3を「寒い、涼しい、やや涼しい、中立、やや暖かい、暖かい、暑い」で表します。PMVの数値を身近な言葉で理解しやすくします。本製品の連続表示区分は製品の規則であり、ラベルだけで部屋の規格適合を判断するものではありません。"
          }
        }
      }
    },
    "env_standard_ashrae_55_scale_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ASHRAE Standard 55 七点标尺"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ASHRAE Standard 55 七點標尺"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ASHRAE Standard 55 seven-point scale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ASHRAE Standard 55 7段階尺度"
          }
        }
      }
    },
