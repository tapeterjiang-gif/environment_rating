        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該增加換氣了。儘快補入新鮮空氣，人多時也可以適當分散活動。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase fresh-air supply soon. In a crowded room, spreading people out may also help."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新鮮な空気を早めに取り入れましょう。混み合っている場合は、人を分散させることも役立ちます。"
          }
        }
