    "env_standard_who_hcho_2010_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 的室内空气质量指南，从健康角度为多种室内污染物提供参考。对于甲醛，指南给出的参考浓度是 0.10 mg/m³，按 30 分钟平均值理解。本项目将它作为甲醛默认依据，并围绕参考值设计六档提示；六档是产品的表达方式，并不是 WHO 原文规定的六个等级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 室內空氣品質指南從健康角度為多種室內污染物提供參考。甲醛的參考濃度為 0.10 mg/m³，依 30 分鐘平均值理解。本專案將它作為甲醛預設依據，並圍繞參考值設計六檔提示；六檔屬於產品表達方式，並非 WHO 原文規定的六個等級。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WHO indoor air quality guidelines provide health-based references for several indoor pollutants. For formaldehyde, the reference is 0.10 mg/m³ over a 30-minute averaging period. This is the project’s default formaldehyde reference. The project builds six messages around that value; those six bands are a product presentation, not six categories prescribed by WHO."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOの室内空気質ガイドラインは、複数の室内汚染物質について健康に基づく参考値を示します。ホルムアルデヒドは30分平均で0.10 mg/m³です。本製品ではこれを既定の基準とし、参考値を中心に6段階の案内を設けています。この6段階は製品の表現方法であり、WHOが定めた6区分ではありません。"
          }
        }
      }
    },
    "env_standard_who_hcho_2010_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 2010 室内空气质量指南"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 2010 室內空氣質量指南"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 2010 Guidelines for Indoor Air Quality"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 2010 室内空気質ガイドライン"
          }
        }
      }
