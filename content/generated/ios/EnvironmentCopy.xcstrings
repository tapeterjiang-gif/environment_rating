{
  "sourceLanguage": "en",
  "strings": {
    "env_co2_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂ 偏高通常提示通风不足。室外空气合适时，可以开窗或开启新风；开门也可能改善空气流通，但仍要有新鲜空气补入。人越多、门窗关闭越久，越值得留意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂ 偏高通常提示通風不足。室外空氣合適時，可以開窗或開啟新風；開門也可能改善空氣流通，但仍要有新鮮空氣補入。人越多、門窗關閉越久，越值得留意。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High CO₂ often points to insufficient ventilation. When outdoor air is suitable, open a window or bring in fresh air mechanically. Opening a door may help circulation, but fresh air still needs to enter. Pay closer attention when more people are present or windows stay closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂が高いときは換気が不足していることがあります。屋外の空気が適切なら窓を開けたり、新鮮な空気を取り入れましょう。ドアを開けると空気は流れやすくなりますが、外気の供給も必要です。人数が多いときや窓を長く閉めているときほど注意しましょう。"
          }
        }
      }
    },
    "env_co2_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二氧化碳会随人员呼吸在室内积累，可用来观察通风是否充足。浓度持续升高时，可考虑增加新风；它不能代表所有空气污染物，也不能代替一氧化碳报警。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二氧化碳會隨人員呼吸在室內累積，可用來觀察通風是否充足。濃度持續升高時，可考慮增加新風；它不能代表所有空氣污染物，也不能取代一氧化碳警報。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂ can build up indoors as people breathe and helps indicate ventilation conditions. A sustained rise suggests a need for more fresh air. It does not represent every pollutant or replace a carbon monoxide alarm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂は人の呼吸によって室内に蓄積し、換気の状況を知る目安になります。上昇が続く場合は新鮮な空気の導入を検討します。すべての汚染物質を表すものではなく、一酸化炭素警報の代わりにはなりません。"
          }
        }
      }
    },
    "env_co2_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CO₂"
          }
        },
