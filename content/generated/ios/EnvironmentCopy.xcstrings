        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "env_tvoc_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TVOC 指数用于观察传感器对多种挥发性有机物的综合响应变化。它不是单一污染物浓度，也不能直接等同于毒性或健康风险。本项目目前不为 TVOC 指数分档，可显示读数与趋势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TVOC 指數用於觀察感測器對多種揮發性有機物的綜合反應變化。它不是單一污染物濃度，也不能直接等同毒性或健康風險。本專案目前不為 TVOC 指數分檔，可顯示讀數與趨勢。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The TVOC index tracks changes in a sensor’s combined response to volatile organic compounds. It is not the concentration of one pollutant or a direct measure of toxicity or health risk. This project currently displays readings and trends without rating bands."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TVOC指数は、複数の揮発性有機化合物に対するセンサーの総合的な応答変化を見る指標です。単一物質の濃度や毒性、健康リスクを直接示しません。本製品では現時点で評価区分を設けず、値と傾向を表示できます。"
          }
        }
      }
    },
    "env_tvoc_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TVOC 指数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TVOC 指數"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TVOC Index"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TVOC指数"
          }
        }
      }
    },
    "env_uv_index_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出门前看看紫外线指数，准备遮阳帽、衣物或防晒用品；指数较高时，可以多走阴凉处，减少正午暴晒。天气凉爽或有云，也不一定代表紫外线很低。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出門前看看紫外線指數，準備遮陽帽、衣物或防曬用品；指數較高時，可以多走陰涼處，減少正午曝曬。天氣涼爽或有雲，也不一定代表紫外線很低。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the UV Index before heading out and prepare a hat, covering clothing, or sunscreen. At higher levels, use shade and limit midday exposure. Cool or cloudy weather does not always mean low UV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外出前に紫外線指数を確認し、帽子、肌を覆う服、日焼け止めを準備しましょう。高いときは日陰を選び、正午前後の直射日光を避けてください。涼しい日や曇りでも、紫外線が低いとは限りません。"
          }
        }
      }
    },
    "env_uv_index_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外线指数反映太阳紫外线对皮肤和眼睛产生损伤的潜在强度，与可见光照度不同。指数越高，越应留意防晒与遮蔽；查看时应区分当前值和当日最大值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外線指數反映太陽紫外線對皮膚與眼睛產生損傷的潛在強度，與可見光照度不同。指數越高，越應留意防曬與遮蔽；查看時應區分目前值與當日最大值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The UV Index describes the potential strength of solar UV damage to skin and eyes, not visible illuminance. Higher values call for greater attention to sun protection and shade. Distinguish a current reading from the daily maximum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外線指数は太陽紫外線による皮膚や目への潜在的な影響の強さを表し、可視光の照度とは異なります。高いほど日焼け対策や日陰に注意し、現在値と日最大値を区別します。"
          }
        }
      }
    },
    "env_uv_index_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外线指数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外線指數"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UV Index"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外線指数"
          }
        }
      }
    },
    "env_uv_index_rating_extreme_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外线极强，尽量减少不必要的户外暴露。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外線極強，盡量減少不必要的戶外暴露。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UV is extreme. Avoid unnecessary outdoor exposure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紫外線が極めて強い状態です。不要な屋外での曝露を避けてください。"
          }
        }
      }
    },
    "env_uv_index_rating_extreme_label": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "极高"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "極高"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extreme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "極めて高い"
          }
        }
      }
    },
    "env_uv_index_rating_extreme_summary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
