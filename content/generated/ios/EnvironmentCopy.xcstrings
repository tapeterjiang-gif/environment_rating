    "env_standard_nab_pollen_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国国家过敏局的花粉监测网络，以树木、禾草和杂草等类别的花粉浓度描述空气中的花粉负荷。本项目采用这些类别的日平均浓度边界，提供低、中、高、极高四档提示。它适合在已知花粉类别时帮助安排日常活动；没有类别的总花粉数，不能直接套用其中某一类的分档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "美國國家過敏局的花粉監測網絡，以樹木、禾草、雜草等類別的花粉濃度描述空氣中的花粉負荷。本專案採用各類別的日平均濃度邊界，提供低、中、高、極高四檔提示，協助安排日常活動；若只有未分類的總花粉數，不能直接套用其中一類的分檔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The US National Allergy Bureau’s monitoring network describes pollen load using concentrations for categories such as trees, grasses, and weeds. The project uses daily-average category boundaries to provide Low, Moderate, High, and Very High messages. These can help with daily planning when the pollen category is known. An unclassified total count cannot simply use one category’s thresholds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国National Allergy Bureauの監視ネットワークは、樹木、イネ科、雑草などの分類別濃度で花粉量を表します。本製品は日平均の分類別境界から、低い・中程度・高い・非常に高いの4段階を示します。種類の分類がわかるときの日常活動の目安となり、分類のない総数に特定分類の境界をそのまま適用することはできません。"
          }
        }
      }
    },
