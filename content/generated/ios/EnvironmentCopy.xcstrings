    "env_o3_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "臭氧偏高时，可以把跑步、骑行等较费力的户外活动改到预报较低的时段，或缩短活动时间。开窗前也看看室外臭氧情况，不要仅靠“空气闻起来清新”来判断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臭氧偏高時，可以把跑步、騎行等較費力的戶外活動改到預報較低的時段，或縮短活動時間。開窗前也看看室外臭氧情況，不要僅靠「空氣聞起來清新」來判斷。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When ozone is high, move strenuous outdoor activities such as running or cycling to a lower forecast period, or shorten them. Check outdoor ozone before opening windows; a fresh smell is not a reliable guide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オゾンが高いときは、ランニングやサイクリングなど負荷の高い屋外活動を、予報が低い時間に移すか短くしましょう。換気前にも外の状況を確認し、空気のにおいだけで判断しないでください。"
          }
        }
      }
    },
    "env_o3_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里关注近地面的臭氧，而不是高空中起保护作用的臭氧层。它可由其他污染物在阳光下反应形成。浓度较高时，可参考当地预报调整户外活动时间与强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡關注近地面的臭氧，而非高空中起保護作用的臭氧層。它可由其他污染物在陽光下反應形成。濃度較高時，可參考當地預報調整戶外活動時間與強度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is ground-level ozone, not the protective ozone layer high above Earth. It can form when other pollutants react in sunlight. At elevated levels, consult local forecasts to adjust outdoor activity timing and intensity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは上空の保護的なオゾン層ではなく、地表付近のオゾンを扱います。他の汚染物質が日光の下で反応して生じることがあります。高い場合は地域の予報に応じて屋外活動の時間や強度を調整します。"
          }
        }
      }
    },
    "env_o3_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "臭氧 O₃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臭氧 O₃"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ozone O₃"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オゾン O₃"
          }
        }
      }
    },
    "env_o3_rating_extremely_poor_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已到最高评级区间，优先离开污染较重的环境，并按相关提示处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已到最高評級區間，優先離開污染較重的環境，並依相關提示處理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the highest rating band. Prioritize leaving the polluted area and follow relevant guidance."
