    "env_pm10_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打扫、走动或扬尘天气都可能让 PM10 升高。可以用湿擦代替干扫，减少室内扬尘，并检查过滤设备；室外沙尘较大时，先减少开窗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打掃、走動或揚塵天氣都可能讓 PM10 升高。可以用濕擦代替乾掃，減少室內揚塵，並檢查過濾設備；室外沙塵較大時，先減少開窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleaning, movement, or dusty weather can raise PM10. Damp wiping instead of dry sweeping can reduce dust. Check filtration, and limit open windows when outdoor dust is heavy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "掃除、人の動き、砂ぼこりでPM10が上がることがあります。乾いたほうきより湿った布で拭くと、ほこりを抑えられます。ろ過設備を確認し、屋外の粉じんが多いときは窓の開放を控えましょう。"
          }
        }
      }
    },
    "env_pm10_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PM10 是空气中空气动力学直径通常不超过 10 微米的可吸入颗粒物，包含 PM2.5。扬尘、道路和施工活动都可能使读数升高；可结合室外情况减少扬尘并改善过滤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PM10 是空氣中空氣動力學直徑通常不超過 10 微米的可吸入顆粒物，包含 PM2.5。揚塵、道路與施工活動都可能使讀數升高；可結合室外情況減少揚塵並改善過濾。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PM10 is inhalable particulate matter generally no more than 10 micrometers in aerodynamic diameter, including PM2.5. Dust, roads, and construction can raise readings. Consider outdoor conditions when controlling dust and improving filtration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PM10は空気力学径が通常10マイクロメートル以下の吸入性粒子で、PM2.5も含みます。ほこり、道路、工事などで増加することがあり、屋外の状況に応じて粉じんの抑制やろ過を検討します。"
          }
        }
      }
    },
    "env_pm10_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PM10"
          }
        },
