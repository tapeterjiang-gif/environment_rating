        }
      }
    },
    "env_standard_epa_aqi_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国 EPA AQI 用六个类别向公众报告空气质量，帮助人们判断何时需要多关注污染情况、调整户外活动。本项目采用其中已支持污染物的浓度分界，提供另一套可选择的评级依据。不同污染物有各自的平均时间和数值处理规则，因此同一个读数在不同标准下，等级可能不完全相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "美國 EPA AQI 以六個類別向公眾報告空氣品質，協助判斷何時需要多關注污染狀況、調整戶外活動。本專案採用其中已支援污染物的濃度分界，提供另一套可選評級依據。不同污染物的平均時間與數值處理規則各有不同，因此同一讀數在不同標準下可能得到不同等級。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The US EPA AQI reports air quality in six categories to help people decide when to pay closer attention to pollution or adjust outdoor activities. The project offers its concentration boundaries for supported pollutants as an alternative reference. Averaging periods and numeric processing differ by pollutant, so the same reading may receive a different rating under another reference."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国EPAのAQIは大気質を6区分で伝え、汚染に注意したり屋外活動を調整する時期を考える助けになります。本製品では対応する物質の濃度境界を選択肢として提供します。物質ごとに平均時間や数値処理が異なるため、同じ読数でも別の基準では評価が変わることがあります。"
          }
        }
      }
    },
    "env_standard_epa_aqi_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国 EPA AQI"
          }
        },
