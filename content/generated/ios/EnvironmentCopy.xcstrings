    "env_standard_who_noise_1999_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO《社区噪声指南》关注声音如何影响日常生活、休息和睡眠，并为不同场景给出参考。指南中的相关参考值以长期等效声级等测量口径表达。本项目借用住宅和睡眠场景的参考，设计便于理解的噪声提示；当前声级读数的四档显示属于产品规则，不代替指南要求的完整长期测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO《社區噪聲指南》關注聲音如何影響生活、休息與睡眠，並為不同場景提供參考。相關參考值採用長期等效聲級等測量方式。本專案參考住宅與睡眠場景，設計易讀的噪聲提示；目前聲級讀數的四檔顯示屬於產品規則，不取代指南要求的完整長期測量。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WHO Guidelines for Community Noise consider how sound affects everyday life, rest, and sleep, and provide references for different settings. Relevant values use measures such as long-term equivalent sound levels. The project draws on home and sleep references for understandable noise messages. Its four bands for current sound readings are product rules and do not replace the guideline’s full long-term measurements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOの環境騒音ガイドラインは、音が日常生活、休息、睡眠にどう影響するかを扱い、場面別の参考値を示します。関連する値には長時間の等価騒音レベルなどを使います。本製品は住宅と睡眠の目安を参考に案内を作っています。現在の音量の4段階表示は製品規則であり、必要な長時間測定の代わりにはなりません。"
          }
        }
      }
    },
    "env_standard_who_noise_1999_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO《社区噪声指南》"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO《社區噪聲指南》"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO Guidelines for Community Noise"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO『地域騒音ガイドライン』"
          }
        }
      }
    },
