          }
        }
      }
    },
    "env_co_rating_extremely_poor_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已到最高评级区间，优先离开污染较重的环境，并按相关提示处理。"
