    "env_standard_epa_humidity_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国 EPA 的湿度建议主要帮助家庭减少潮湿和霉菌问题。它建议尽可能将室内相对湿度保持在 30%–50%，并控制在 60% 以下。本项目将这份建议作为可选依据，用“偏干、适宜、略湿、偏湿”帮助你判断是否需要加湿、通风或除湿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "美國 EPA 的濕度建議主要協助家庭減少潮濕與黴菌問題。它建議盡可能將室內相對濕度保持在 30%–50%，並控制在 60% 以下。本專案將這份建議作為可選依據，以「偏乾、適宜、略濕、偏濕」協助判斷是否需要加濕、通風或除濕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The US EPA’s humidity guidance helps households manage dampness and mold. It recommends keeping indoor relative humidity around 30–50% where possible, and below 60%. The project offers this as an optional reference, using Dry, Suitable, Slightly Humid, and Humid messages to help you consider humidification, ventilation, or dehumidification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国EPAの湿度の助言は、家庭の湿気やカビの管理に役立つものです。可能なら相対湿度を30～50%程度に保ち、60%未満に抑えることを勧めています。本製品では選択できる目安として、乾燥気味・適切・やや多湿・多湿を表示し、加湿、換気、除湿を考える手助けにします。"
          }
        }
      }
    },
    "env_standard_epa_humidity_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "美国 EPA 湿度指南"
          }
        },
