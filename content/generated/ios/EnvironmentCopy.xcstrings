    "env_temperature_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感觉冷或热时，可以先从衣着、空调和风扇做小幅调整，等一会儿再看体感是否改善。每个人的舒适点不同，不必为了追求“中性”反复调节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感覺冷或熱時，可以先從衣著、空調與風扇做小幅調整，等一會兒再看體感是否改善。每個人的舒適點不同，不必為了追求「中性」反覆調節。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you feel cold or warm, try a small change to clothing, air conditioning, or a fan, then give it time. Comfort varies, so there is no need to keep adjusting just to reach Neutral."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寒さや暑さを感じたら、服装、空調、扇風機を少し調整して様子を見ましょう。快適さは人それぞれなので、「中立」を目指して何度も調整する必要はありません。"
          }
        }
      }
    },
    "env_temperature_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度表示空气的冷热程度，但体感还受湿度、风速、衣着和活动量影响。本项目结合这些条件计算 PMV，以七档描述冷热感，不按温度读数直接分档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度表示空氣的冷熱程度，但體感還受濕度、風速、衣著與活動量影響。本專案結合這些條件計算 PMV，以七檔描述冷熱感，不直接依溫度讀數分檔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature describes how warm or cold the air is. Humidity, air movement, clothing, and activity also affect how it feels. The project combines these conditions in PMV to describe seven thermal sensations; it does not rate air temperature alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気温は空気の暖かさや冷たさを表します。体感には湿度、気流、服装、活動量も影響します。本製品はこれらをPMVに組み合わせ、気温だけでなく7段階の温冷感を示します。"
          }
        }
      }
    },
    "env_temperature_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "溫度"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperature"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度"
          }
        }
      }
    },
    "env_tvoc_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
