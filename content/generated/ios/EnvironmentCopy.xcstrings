    "env_illuminance_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读、写字或做手工时，可以在实际使用的位置补一盏灯，再调整灯的位置，避免手影和刺眼反光。设备处的照度与桌面可能不同，不必单纯追求更高的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀、寫字或做手工時，可以在實際使用的位置補一盞燈，再調整燈的位置，避免手影與刺眼反光。裝置處的照度與桌面可能不同，不必單純追求更高的數字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For reading, writing, or crafts, add a light at the task location and adjust it to avoid hand shadows and glare. Light at the device may differ from the desk, so a higher number is not the goal by itself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読書、筆記、手作業では実際の作業位置に照明を足し、手の影やまぶしい反射を避けるよう調整しましょう。機器の位置と机上の照度は異なるため、数値を上げることだけを目標にする必要はありません。"
          }
        }
      }
    },
    "env_illuminance_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照度表示落在单位面积上的可见光多少，单位为 lx。不同活动需要的照度不同，并非越亮越好。设备单点读数只作场景提示，阅读或作业时还应确认实际任务面的光照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照度表示落在單位面積上的可見光多少，單位為 lx。不同活動需要的照度不同，並非越亮越好。裝置單點讀數僅作場景提示，閱讀或作業時還應確認實際工作面的光照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Illuminance measures visible light falling on a surface, in lux. Different activities need different levels; brighter is not always better. A single device reading is a scene hint. Check the actual task surface for reading or work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照度は面に届く可視光の量をルクスで表します。活動により必要な明るさは異なり、明るいほど良いわけではありません。機器の一点の値は場面の目安です。読書や作業では実際の作業面を確認します。"
          }
        }
      }
    },
    "env_illuminance_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光照 / 照度"
          }
        },
