    "env_standard_ies_rp_11_26_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ANSI/IES/ALA RP-11-26 是面向住宅室内外照明的推荐实践，按空间、活动和实际任务面给出照度与设计建议。本项目参考其中的照度层级，整理成从氛围照明到精细作业的活动提示。这样可以帮助你理解当前光线更接近哪类需要，但设备位置的单点读数，仍不能代表书桌或整个房间的照明条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ANSI/IES/ALA RP-11-26 是住宅室內外照明的推薦實務，依空間、活動與實際工作面提供照度及設計建議。本專案參考其中的照度層級，整理成從氛圍照明到精細作業的活動提示，協助理解目前光線接近哪類需要；裝置位置的單點讀數仍不能代表書桌或整個房間的照明條件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ANSI/IES/ALA RP-11-26 is a recommended practice for indoor and outdoor residential lighting, with guidance for spaces, activities, and actual task surfaces. The project uses selected illuminance levels to describe activities from ambient lighting to detail work. This makes a reading easier to understand, while recognizing that one device location does not represent a desk surface or an entire room."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ANSI/IES/ALA RP-11-26は住宅の屋内外照明の推奨指針で、空間、活動、実際の作業面に応じた照度や設計を案内します。本製品では照度の段階を参考に、雰囲気照明から精密作業までの活動の目安に整理しています。ただし、機器位置の一点の測定値は、机上や部屋全体の照明を表すものではありません。"
          }
        }
      }
    },
