    "env_standard_oehha_hcho_2008_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加州 OEHHA 发布参考暴露水平，用于帮助评估接触空气污染物的健康风险。其中甲醛的 1 小时急性参考值为 0.055 mg/m³。本项目提供这套可选依据，供需要采用加州参考口径的产品使用；它是加州的健康参考，不是全美国通用的法规限值，页面六档也属于产品映射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加州 OEHHA 發布參考暴露水平，協助評估接觸空氣污染物的健康風險。甲醛的 1 小時急性參考值為 0.055 mg/m³。本專案提供這套可選依據，供需要採用加州參考口徑的產品使用；它並非全美國通用的法規限值，頁面六檔也屬於產品映射。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "California OEHHA publishes reference exposure levels to support assessment of health risks from air pollutants. Its one-hour acute reference value for formaldehyde is 0.055 mg/m³. The project offers this option for products using the California reference. It is not a nationwide US legal limit, and the six displayed bands are the project’s own mapping."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カリフォルニア州OEHHAは、大気汚染物質への曝露による健康リスク評価を支援する参考曝露レベルを示します。ホルムアルデヒドの1時間急性参考値は0.055 mg/m³です。本製品ではこの目安を使う場合の選択肢として提供します。米国全体の法的限度値ではなく、6段階の表示も製品の対応付けです。"
          }
        }
      }
    },
    "env_standard_oehha_hcho_2008_name": {
      "localizations": {
