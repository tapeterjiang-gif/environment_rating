    "env_humidity_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空气偏干时，可以适当加湿；偏湿时，先看看浴室、晾衣或漏水是否带来水汽，再考虑排风或除湿。室外也很潮湿时，开窗未必能降湿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空氣偏乾時，可以適當加濕；偏濕時，先看看浴室、晾衣或漏水是否帶來水汽，再考慮排風或除濕。室外也很潮濕時，開窗未必能降濕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When air is dry, add moisture as needed. When damp, check bathrooms, drying laundry, or leaks, then consider exhaust ventilation or a dehumidifier. Opening windows may not help if outdoor air is also humid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "乾燥時は必要に応じて加湿しましょう。湿気が多いときは浴室、部屋干し、漏水を確認し、排気や除湿を検討してください。屋外も湿っていると、窓を開けても湿度が下がらないことがあります。"
          }
        }
      }
    },
    "env_humidity_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对湿度表示当前温度下，空气中的水汽量相对于饱和状态的百分比。过干可能带来干燥感，持续潮湿则有利于霉菌生长。保持在所选参考范围内，有助于兼顾舒适与防潮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相對濕度表示目前溫度下，空氣中的水汽量相對於飽和狀態的百分比。過乾可能帶來乾燥感，持續潮濕則有利於黴菌生長。維持所選參考範圍，有助兼顧舒適與防潮。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relative humidity is the percentage of water vapor in the air compared with saturation at the same temperature. Dry air may feel uncomfortable, while persistent dampness supports mold growth. Staying within the selected reference range helps balance comfort and moisture control."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相対湿度は、同じ温度の飽和状態に対する空気中の水蒸気量の割合です。乾燥は不快感につながり、湿気が続くとカビが育ちやすくなります。選択した目安の範囲を保つことで、快適さと防湿の両立を図れます。"
          }
        }
      }
    },
    "env_humidity_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相对湿度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相對濕度"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relative humidity"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相対湿度"
          }
        }
      }
    },
