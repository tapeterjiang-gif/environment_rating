    },
    "env_co2_rating_good_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前通风情况不错，保持现有换气习惯就好。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前通風情況不錯，保持現有換氣習慣就好。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventilation looks good for now. Keep your usual fresh-air routine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の換気状況は良好です。普段の換気を続けましょう。"
          }
        }
      }
    },
