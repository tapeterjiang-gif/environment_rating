    "env_co_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的分档用于室外空气质量提示。如果一氧化碳报警器响起，或怀疑附近存在燃烧泄漏，应立即离开可疑环境并寻求当地应急帮助，不要等评级变化，也不要只靠开窗处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的分檔用於室外空氣品質提示。如果一氧化碳警報器響起，或懷疑附近存在燃燒洩漏，應立即離開可疑環境並尋求當地緊急協助，不要等評級變化，也不要只靠開窗處理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These bands describe outdoor air quality. If a CO alarm sounds or you suspect a combustion leak, leave the affected area immediately and seek local emergency help. Do not wait for a rating change or rely only on opening windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この区分は屋外の大気質の案内です。一酸化炭素警報が鳴ったり、燃焼機器からの漏れが疑われる場合は、その場を離れ、地域の緊急窓口に助けを求めてください。評価の変化を待ったり、窓を開けるだけで済ませないでください。"
          }
        }
      }
    },
    "env_co_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一氧化碳是燃料不完全燃烧时可能产生的无色无味气体。这里按室外空气质量标准评价相应平均浓度；急性风险需由专用报警设备处理，不能等待空气质量分档升高。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一氧化碳是燃料不完全燃燒時可能產生的無色無味氣體。這裡依室外空氣品質標準評價相應平均濃度；急性風險需由專用警報裝置處理，不能等待空氣品質分檔升高。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbon monoxide is a colorless, odorless gas that can result from incomplete combustion. This rating uses outdoor air quality references and their averaging periods. Acute hazards require a dedicated alarm; do not wait for an air quality rating to rise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一酸化炭素は不完全燃焼で生じることがある無色・無臭の気体です。ここでは屋外大気の基準と平均時間に基づいて評価します。急性の危険には専用警報器が必要で、評価段階の上昇を待ってはいけません。"
          }
        }
      }
    },
    "env_co_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一氧化碳 CO"
