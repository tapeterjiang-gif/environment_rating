    "env_so2_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "室外 SO₂ 偏高时，可以少在污染较重的地方停留，把户外活动改到空气较好的时段。是否通风也要结合室外读数，浓度高时不要盲目开窗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "室外 SO₂ 偏高時，可以少在污染較重的地方停留，把戶外活動改到空氣較好的時段。是否通風也要結合室外讀數，濃度高時不要盲目開窗。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When outdoor SO₂ is high, spend less time in affected places and move outdoor activities to a cleaner-air period. Consider outdoor readings before ventilating; opening windows may not help when levels are high."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "屋外のSO₂が高いときは、汚染の多い場所での滞在を減らし、空気の良い時間に活動しましょう。換気も屋外の値を踏まえ、高濃度のときはむやみに窓を開けないでください。"
          }
        }
      }
    },
    "env_so2_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二氧化硫主要与含硫燃料燃烧及部分工业排放有关，也可能影响呼吸道。读数应按所选标准的平均时间理解；浓度较高时，可结合当地提示减少相关暴露。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二氧化硫主要與含硫燃料燃燒及部分工業排放有關，也可能影響呼吸道。讀數應依所選標準的平均時間理解；濃度較高時，可結合當地提示減少相關暴露。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfur dioxide is mainly associated with sulfur-containing fuel combustion and some industrial emissions, and can affect breathing. Interpret readings over the selected reference’s averaging period. At elevated levels, follow local guidance to reduce exposure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二酸化硫黄は主に硫黄を含む燃料の燃焼や一部の工業排出に関係し、呼吸に影響することがあります。基準の平均時間に沿って読み取り、高い場合は地域の案内に応じて曝露を減らします。"
          }
        }
      }
    },
    "env_so2_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二氧化硫 SO₂"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二氧化硫 SO₂"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulfur dioxide SO₂"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二酸化硫黄 SO₂"
          }
        }
      }
    },
    "env_so2_rating_extremely_poor_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已到最高评级区间，优先离开污染较重的环境，并按相关提示处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已到最高評級區間，優先離開污染較重的環境，並依相關提示處理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the highest rating band. Prioritize leaving the polluted area and follow relevant guidance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も高い評価区分です。汚染の多い場所から離れることを優先し、関連する案内に従ってください。"
          }
        }
      }
    },
