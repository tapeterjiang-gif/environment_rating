    "env_standard_hj_633_2026_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HJ 633—2026 是中国环境空气质量指数的技术规定，说明如何根据污染物浓度计算 AQI、划分污染级别并报告结果。本项目参考其中的浓度分界，为颗粒物及已支持的室外气体提供评级选项。使用时还要对应标准要求的平均时间；例如小时值和日平均值，不能直接混用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HJ 633—2026 是中國環境空氣品質指數的技術規定，說明如何依污染物濃度計算 AQI、劃分污染級別與報告結果。本專案參考其中的濃度分界，提供顆粒物及已支援室外氣體的評級選項。讀數還須符合標準的平均時間，例如小時值與日平均值不能直接混用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HJ 633—2026 sets out China’s technical rules for calculating AQI from pollutant concentrations, assigning pollution categories, and reporting results. The project uses its concentration boundaries for particulate matter and supported outdoor gases. Readings must also match the required averaging period: an hourly value and a daily average are not interchangeable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HJ 633—2026は、中国の大気質指数について、濃度からのAQI計算、汚染区分、報告方法を定めた技術規定です。本製品はその濃度境界を粒子状物質と対応する屋外気体の評価に使います。必要な平均時間も合わせる必要があり、1時間値と日平均値をそのまま置き換えることはできません。"
          }
        }
      }
    },
