    "env_pollen_advice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对花粉敏感的话，可以把这项读数和自己的反应一起看。花粉较多时，减少长时间开窗，外出后更换外衣；同样的浓度，不同花粉类型带来的感受可能不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對花粉敏感的話，可以把這項讀數與自己的反應一起看。花粉較多時，減少長時間開窗，外出後更換外衣；同樣的濃度，不同花粉類型帶來的感受可能不同。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are sensitive to pollen, read the count alongside your own reactions. When pollen is abundant, avoid leaving windows open for long and change outer clothing after going out. Different pollen types can affect you differently at the same count."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "花粉に敏感な方は、値とご自身の反応を合わせて見ましょう。花粉が多いときは窓を長く開けず、外出後に上着を替えるなどの工夫ができます。同じ数でも花粉の種類で感じ方は変わります。"
          }
        }
      }
    },
    "env_pollen_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花粉读数表示单位体积空气中的花粉数量，不同种类的致敏潜力不同，分档也随类型和标准变化。敏感者可结合个人反应安排出行；只有总数而没有类型时，不应推断具体负荷等级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "花粉讀數表示單位體積空氣中的花粉數量，不同種類的致敏潛力不同，分檔也隨類型與標準變化。敏感者可結合個人反應安排出行；只有總數而沒有類型時，不應推斷具體負荷等級。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pollen readings count grains per volume of air. Allergenic potential and rating thresholds differ by type and reference. Sensitive people can plan activities based on their own response. A total count without a type does not establish a load rating."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "花粉値は空気の単位体積中の花粉数です。種類によってアレルゲン性と評価境界が異なります。敏感な方は自身の反応を踏まえて外出を計画できます。種類のない総数だけでは負荷段階を判断できません。"
          }
        }
      }
    },
    "env_pollen_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花粉"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "花粉"
          }
        },
        "en": {
