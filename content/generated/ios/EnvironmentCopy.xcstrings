    "env_standard_gbt_18883_2022_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GB/T 18883—2022 是中国的室内空气质量标准，对室内污染物限值和检验方法作出约定。甲醛限值为 0.08 mg/m³，对应 1 小时平均。本项目将它作为甲醛的可选依据，方便产品采用这套参考口径；页面中的六档提示是产品根据该限值设计的，不等于一次完整的室内空气质量达标检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GB/T 18883—2022 是中國的室內空氣品質標準，約定污染物限值與檢驗方法。甲醛限值為 0.08 mg/m³，對應 1 小時平均。本專案將它作為可選甲醛依據；頁面六檔提示是依此限值設計的產品規則，不等同一次完整的室內空氣品質達標檢測。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GB/T 18883—2022 is China’s indoor air quality standard, covering pollutant limits and test methods. Its formaldehyde limit is 0.08 mg/m³ as a one-hour average. The project offers it as an optional formaldehyde reference. Its six display bands are product rules based on that limit; the display is not a complete indoor air quality compliance test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GB/T 18883—2022は中国の室内空気質規格で、汚染物質の限度値と検査方法を定めています。ホルムアルデヒドの限度値は1時間平均で0.08 mg/m³です。本製品では選択できる参考基準としています。画面の6段階はその限度値に基づく製品規則であり、室内空気質の適合検査全体を行うものではありません。"
          }
        }
      }
    },
    "env_standard_gbt_18883_2022_name": {
      "localizations": {
        "zh-Hans": {
