    "env_standard_who_uv_index_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO《全球太阳紫外线指数：实用指南》用低、中、高、很高、极高五个等级，帮助公众理解太阳紫外线对皮肤和眼睛的潜在影响，并据此安排防晒与遮蔽。本项目采用这套分级，状态色与图示色也使用 WHO 指定的 RGB 值。查看时应留意显示的是当前指数还是当日最大值，它与照度读数并不是同一回事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO《全球太陽紫外線指數：實用指南》以低、中、高、很高、極高五個等級，協助理解太陽紫外線對皮膚與眼睛的潛在影響，並安排防曬與遮蔽。本專案採用此分級，狀態色與圖示色也使用 WHO 指定的 RGB 值。查看時應留意是目前指數還是當日最大值，它與照度讀數並非同一回事。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WHO Global Solar UV Index practical guide uses five exposure levels to explain the potential effects of solar UV on skin and eyes and help people plan sun protection and shade. The project adopts these levels and WHO’s specified RGB values for status and chart colors. Check whether a display shows the current index or the daily maximum; the UV Index is different from illuminance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHOの世界太陽紫外線指数実用ガイドは、5段階の曝露区分で皮膚や目への潜在的な影響を伝え、日焼け対策や日陰の利用を考える助けにします。本製品はこの区分を使い、状態色とグラフ色もWHO指定のRGB値を採用します。現在値か日最大値かを確認してください。紫外線指数は照度とは別の指標です。"
          }
        }
      }
    },
    "env_standard_who_uv_index_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 全球太阳紫外线指数"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 全球太陽紫外線指數"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO Global Solar UV Index"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO世界太陽紫外線指数"
          }
        }
      }
    },
