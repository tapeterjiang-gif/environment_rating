    "env_standard_uba_humidity_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "德国联邦环境署的湿度指南从日常通风和住宅防潮出发，建议全年将相对湿度保持在约 40%–60%。这为家中湿度提供了一个容易理解的参考范围。本项目默认采用这套依据：低于范围提示偏干，高于范围提示偏湿，方便你根据读数调整加湿或除湿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "德國聯邦環境署的濕度指南從日常通風與住宅防潮出發，建議全年將相對濕度保持在約 40%–60%。這為居家濕度提供容易理解的參考範圍。本專案預設採用此依據：低於範圍提示偏乾，高於範圍提示偏濕，方便依讀數調整加濕或除濕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The German Environment Agency’s humidity guidance approaches moisture through everyday ventilation and damp prevention, suggesting roughly 40–60% relative humidity throughout the year. It provides a simple reference range for the home. This is the project’s default: readings below the range are Dry and those above it Humid, helping you decide whether to add or remove moisture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドイツ連邦環境庁の湿度ガイドは、日常の換気と住宅の防湿の観点から、通年で相対湿度40～60%程度を勧めています。家庭で使いやすい目安の範囲です。本製品の既定値として、この範囲より低ければ乾燥気味、高ければ多湿と示し、加湿や除湿の判断に役立てます。"
          }
        }
      }
    },
    "env_standard_uba_humidity_name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "德国 UBA 湿度指南"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "德國 UBA 濕度指南"
          }
        },
        "en": {
