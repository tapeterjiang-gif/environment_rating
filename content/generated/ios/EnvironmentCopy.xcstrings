    "env_co2_rating_moderate_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屋里有些闷了，试试开窗或开启新风，再看看读数有没有回落。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "屋內有些悶了，試試開窗或開啟新風，再看看讀數有沒有回落。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try opening a window or bringing in fresh air, then check whether the reading falls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "窓を開けるなど外気を取り入れて、値が下がるか確認しましょう。"
          }
        }
      }
    },
