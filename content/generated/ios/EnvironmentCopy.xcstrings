    "env_standard_iso_7730_2025_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 7730 是一套帮助理解人体冷热感的国际标准。它不只看室温，还结合湿度、风速、辐射温度、衣着和活动量，用 PMV 与 PPD 估计一群人的热感觉和不满意比例。本项目采用这些计算方法，帮助你理解当前环境为什么偏冷、偏热或接近中性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 7730 是協助理解人體冷熱感的國際標準。它不只看室溫，還結合濕度、風速、輻射溫度、衣著與活動量，以 PMV 和 PPD 估計一群人的熱感覺與不滿意比例。本專案採用這些計算方法，協助你理解目前環境為何偏冷、偏熱或接近中性。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 7730 is an international standard for understanding how people experience the thermal environment. It looks beyond air temperature to humidity, air speed, radiant temperature, clothing, and activity. PMV and PPD estimate a group’s thermal sensation and the proportion likely to be dissatisfied; this project uses those methods to explain cooler, warmer, or near-neutral conditions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 7730は、人が熱環境をどう感じるかを理解するための国際規格です。室温だけでなく、湿度、風速、放射温度、服装、活動量も考慮します。PMVとPPDで集団の温冷感と不満足者の割合を推定し、本製品では寒い側・暑い側・中立に近い状態を説明するために使います。"
          }
        }
      }
    },
    "env_standard_iso_7730_2025_name": {
