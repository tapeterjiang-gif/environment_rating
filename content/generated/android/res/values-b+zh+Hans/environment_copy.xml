  <string name="env_illuminance_advice" formatted="false">阅读、写字或做手工时，可以在实际使用的位置补一盏灯，再调整灯的位置，避免手影和刺眼反光。设备处的照度与桌面可能不同，不必单纯追求更高的数字。</string>
  <string name="env_illuminance_description" formatted="false">照度表示落在单位面积上的可见光多少，单位为 lx。不同活动需要的照度不同，并非越亮越好。设备单点读数只作场景提示，阅读或作业时还应确认实际任务面的光照。</string>
  <string name="env_illuminance_name" formatted="false">光照 / 照度</string>
  <string name="env_illuminance_rating_ambient_detail" formatted="false">当前读数接近氛围照明的照度层级。可营造柔和氛围；若要阅读或做手工，请在实际使用位置补光。</string>
  <string name="env_illuminance_rating_ambient_label" formatted="false">氛围照明</string>
  <string name="env_illuminance_rating_ambient_summary" formatted="false">当前读数接近氛围照明的照度层级。可营造柔和氛围；若要阅读或做手工，请在实际使用位置补光。</string>
  <string name="env_illuminance_rating_daily_activity_detail" formatted="false">当前读数接近日常活动的照度层级。可作为一般活动的参考，阅读写字时仍应确认桌面是否足够明亮。</string>
  <string name="env_illuminance_rating_daily_activity_label" formatted="false">日常活动</string>
  <string name="env_illuminance_rating_daily_activity_summary" formatted="false">当前读数接近日常活动的照度层级。可作为一般活动的参考，阅读写字时仍应确认桌面是否足够明亮。</string>
  <string name="env_illuminance_rating_detail_work_detail" formatted="false">当前读数提示：该读数接近精细作业的照度层级。精细工作还需确认实际任务面的照度、均匀度与反光，不必一味增加亮度。</string>
  <string name="env_illuminance_rating_detail_work_label" formatted="false">精细作业</string>
  <string name="env_illuminance_rating_detail_work_summary" formatted="false">当前读数提示：该读数接近精细作业的照度层级。精细工作还需确认实际任务面的照度、均匀度与反光，不必一味增加亮度。</string>
  <string name="env_illuminance_rating_focused_activity_detail" formatted="false">当前读数接近专注活动的照度层级。进行需要专注的活动时，可调整灯的位置，避免局部过暗或眩光。</string>
  <string name="env_illuminance_rating_focused_activity_label" formatted="false">专注活动</string>
  <string name="env_illuminance_rating_focused_activity_summary" formatted="false">当前读数接近专注活动的照度层级。进行需要专注的活动时，可调整灯的位置，避免局部过暗或眩光。</string>
  <string name="env_illuminance_rating_low_light_detail" formatted="false">当前读数较低，需在活动位置确认照度。走动或寻找物品时可补充照明，阅读前请确认桌面光线。</string>
  <string name="env_illuminance_rating_low_light_label" formatted="false">低照环境</string>
  <string name="env_illuminance_rating_low_light_summary" formatted="false">当前读数较低，需在活动位置确认照度。走动或寻找物品时可补充照明，阅读前请确认桌面光线。</string>
  <string name="env_illuminance_rating_reading_detail" formatted="false">当前读数接近阅读学习的照度层级。阅读写字时，也请检查桌面照明是否均匀，并避开手影与刺眼反光。</string>
  <string name="env_illuminance_rating_reading_label" formatted="false">阅读学习</string>
