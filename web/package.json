{
  "name": "@tapeterjiang-gif/environment-rating",
  "version": "0.52.0",
  "description": "Environment rating algorithms for browsers, Web Workers, and Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./dist/environment-rating-wasm.wasm"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ./scripts/build-wasm.mjs && tsc -p tsconfig.json",
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "build:typescript": "tsc -p tsconfig.json",
    "test": "node --test ./tests/*.test.mjs",
    "test:browser": "node ./tests/browser-smoke.mjs",
    "prepack": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "air-quality",
    "environment",
    "matter",
    "pmv",
    "webassembly"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tapeterjiang-gif/environment_rating.git",
    "directory": "web"
  },
  "license": "UNLICENSED",
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
